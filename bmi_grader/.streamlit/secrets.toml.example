# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요. secrets.toml 은 절대 깃에 올리지 마세요.
OPENAI_API_KEY = "sk-..."
TEACHER_PASSWORD = "교사용-비밀번호"

# 선택 설정
OPENAI_MODEL = "gpt-5-mini"        # 채점에 쓸 모델
MAX_SUBMISSIONS = 1                # 학생 1명당 제출 가능 횟수
SHOW_RESULT_TO_STUDENT = true      # 제출 직후 학생에게 점수·피드백 보여주기
RUN_STUDENT_CODE = true            # 테스트 입력으로 학생 코드를 실제 실행해 채점 근거로 쓰기
STUDENT_ID_PATTERN = '^\d{4,8}$'   # 학번 형식(정규식)
